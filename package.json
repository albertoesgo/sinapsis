{
  "name": "sinapsis",
  "version": "1.4.0",
  "description": "Un cerebro 3D en tiempo real que muestra la actividad real de Claude Code: proyectos, sesiones, modelos, herramientas, skills, subagentes y consumo.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "demo": "node server/index.js --demo",
    "test": "node --test",
    "build:demo": "node scripts/build-demo.mjs",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/uninstall-service.sh",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "donde": "node scripts/donde.mjs",
    "skill:install": "bash scripts/install-skill.sh",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:remove": "node scripts/install-hooks.mjs --remove"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.170.0"
  },
  "keywords": [
    "claude-code",
    "three.js",
    "dashboard",
    "visualization",
    "webgl",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/albertoesgo/sinapsis"
  },
  "homepage": "https://albertoesgo.github.io/sinapsis/",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0"
  }
}
